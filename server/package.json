{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.28.2",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "dev": "pnpm exec nodemon",
        "clean": "rimraf dist/",
        "copy-files": "copyfiles -u 1 \"src/openapi/**/*.yaml\" \"src/mailtrap/template/**\" dist/",
        "build": "pnpm clean && tsc && pnpm copy-files && tsc-alias",
        "start": "node dist/index.js",
        "seed": "tsx src/scripts/seed.ts",
        "seed:slot": "tsx src/scripts/seed-slot.ts",
        "seed:slot:cassandra": "tsx src/scripts/seed-slot-cassandra.ts",
        "lint": "eslint . ",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/index.ts",
        "bundle:swagger": "pnpm exec swagger-cli bundle src/openapi/openapi.yaml -o src/openapi/bundle.yaml --type yaml",
        "preinstall": "pnpm dlx only-allow pnpm"
    },
    "engines": {
        "node": "24.12.0",
        "pnpm": "10.28.2"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@apidevtools/json-schema-ref-parser": "^15.2.2",
        "@google/generative-ai": "0.24.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/mssql": "^9.1.9",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^7.0.9",
        "@types/passport": "^1.0.17",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/uuid": "^11.0.0",
        "bcrypt": "^6.0.0",
        "cassandra-driver": "^4.7.2",
        "chalk": "^5.6.2",
        "cloudinary": "^2.9.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "handlebars": "^4.7.8",
        "js-yaml": "^4.1.1",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "mssql": "^12.2.0",
        "multer": "^2.0.2",
        "node-cache": "5.1.2",
        "node-cron": "4.2.1",
        "nodemailer": "^8.0.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "prom-client": "15.1.3",
        "socket.io": "4.8.3",
        "stripe": "20.3.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "tedious": "^19.2.0",
        "uuid": "^13.0.0",
        "winston": "^3.19.0",
        "yaml": "^2.8.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.2.0",
        "@types/node-cache": "4.2.5",
        "@types/passport-google-oauth20": "^2.0.17",
        "copyfiles": "^2.4.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.3.0",
        "nodemon": "^3.1.11",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.2",
        "swagger-cli": "^4.0.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.54.0"
    }
}
