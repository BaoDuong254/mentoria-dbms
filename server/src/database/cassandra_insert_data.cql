-- =============================================================================
-- MENTORIA — Cassandra Seed Data
-- Source: INSERT_DATA.sql (SQL Server)
--
-- This file maps normalized SQL Server seed data to denormalized Cassandra
-- query tables. One SQL entity may write to multiple Cassandra tables.
--
-- Counter tables are populated using UPDATE ... + value (no INSERT).
-- =============================================================================

USE mentoriadbms;

-- =============================================================================
-- 1) USERS
-- SQL Server tables: users + user_social_links
-- Cassandra tables: users_by_id + users_by_email
-- Why two inserts: Cassandra query-first design needs lookup by both user_id
-- and email (authentication path).
-- =============================================================================

