-- =============================================================================
-- 11) MESSAGES + INBOX
-- SQL Server table: messages
-- Cassandra tables: messages_by_conversation + conversations_by_user
-- Denormalization:
--   - messages_by_conversation stores message stream by conversation bucket
--   - conversations_by_user stores latest message snapshot per user pair
-- =============================================================================

INSERT INTO messages_by_conversation (conversation_id, bucket, sent_time, message_id, sender_id, receiver_id, content, sender_first_name, sender_last_name, sender_avatar_url) VALUES ('a1000000-0000-0000-0000-000000000001_a1000000-0000-0000-0000-000000000031', '2024-12', '2024-12-08 10:00:00+0000', f0000000-0000-0000-0000-000000000001, a1000000-0000-0000-0000-000000000031, a1000000-0000-0000-0000-000000000001, 'Hi John! I''m excited about our upcoming session on React.', 'Alice', 'Smith', 'https://i.pravatar.cc/150?img=20');
