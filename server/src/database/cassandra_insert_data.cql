-- =============================================================================
-- 7) INVOICES / PAYMENTS
-- SQL Server tables: invoices + plan_registerations + bookings + plans +
-- discounts + users
-- Cassandra tables: invoices_by_mentee + invoices_by_stripe_session
-- Denormalization: this flattens payment, plan, mentor, and discount data
-- into a single invoice read model per mentee.
-- =============================================================================

BEGIN UNLOGGED BATCH
INSERT INTO invoices_by_mentee (mentee_id, paid_time, invoice_id, plan_registration_id, method, stripe_session_id, stripe_customer_id, stripe_customer_email, stripe_payment_intent_id, stripe_charge_id, stripe_balance_transaction_id, stripe_receipt_url, payment_status, currency, amount_subtotal, amount_total, mentor_id, mentor_first_name, mentor_last_name, plan_type, plan_description, discuss_message, discount_name, discount_amount) VALUES (a1000000-0000-0000-0000-000000000031, '2025-12-05 10:30:00+0000', e5000000-0000-0000-0000-000000000001, f6000000-0000-0000-0000-000000000001, 'Credit Card', 'cs_seed_000001', 'cus_seed_000031', 'alice.smith@example.com', 'pi_seed_000001', 'ch_seed_000001', 'txn_seed_000001', 'https://payments.mentoria.dev/receipts/1', 'paid', 'usd', 50.00, 45.00, a1000000-0000-0000-0000-000000000001, 'John', 'Doe', 'Beginner', '30-minute focused mentorship session covering React, Node.js, and web development best practices', 'Looking forward to learning web development with John!', 'WELCOME10', 5.00);
INSERT INTO invoices_by_stripe_session (stripe_session_id, invoice_id, mentee_id, paid_time, payment_status) VALUES ('cs_seed_000001', e5000000-0000-0000-0000-000000000001, a1000000-0000-0000-0000-000000000031, '2025-12-05 10:30:00+0000', 'paid');
APPLY BATCH;

