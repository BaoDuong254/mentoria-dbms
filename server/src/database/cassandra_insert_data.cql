-- =============================================================================
-- 3) MENTOR PROFILES + SEARCH TABLES
-- SQL Server tables: mentors + users + mentor_languages + set_skill +
-- own_skill + work_for + companies + job_title + plans + feedbacks
-- Cassandra tables: mentor_profiles + mentors_by_category +
--                   mentors_by_skill + mentors_by_country
-- Why multiple inserts: search access patterns are pre-materialized by
-- category, skill, and country for fast partition reads.
-- =============================================================================

BEGIN UNLOGGED BATCH
INSERT INTO mentor_profiles (mentor_id, first_name, last_name, email, avatar_url, country, timezone, status, bio, headline, response_time, cv_url, bank_name, account_number, account_holder_name, bank_branch, swift_code, total_mentee, total_stars, total_reviews, rating, languages, skills, categories, companies, social_links, total_plans, lowest_plan_price, highest_plan_price, created_at, updated_at) VALUES (a1000000-0000-0000-0000-000000000001, 'John', 'Doe', 'john.doe@example.com', 'https://i.pravatar.cc/150?img=1', 'United States', 'America/New_York', 'Active', 'Experienced full-stack developer with 10+ years in web development. Specialized in React, Node.js, and cloud architecture. Passionate about helping developers grow their careers.', 'Senior Full-Stack Developer & Tech Lead', 'Within 24 hours', 'https://example.com/cv/johndoe.pdf', 'Chase Bank', '1234567890', 'John Doe', 'New York Main Branch', 'CHASUS33', 2, 5, 1, 5.00, {'English','Spanish'}, {'AWS','CI/CD','Git','JavaScript','Node.js','React','TypeScript'}, {'Backend Development','Cloud & DevOps','Cybersecurity','Web Development'}, {'Google':'Senior Software Engineer','Microsoft':'Tech Lead'}, {'GitHub':'https://github.com/johndoe','LinkedIn':'https://linkedin.com/in/johndoe','Twitter':'https://twitter.com/johndoe'}, 3, 50.00, 150.00, '2025-01-01 00:00:00+0000', '2025-01-01 00:00:00+0000');
